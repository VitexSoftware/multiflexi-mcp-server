# Example environment variables for MultiFlexi MCP Server

# Required: MultiFlexi API host URL - must include the full API base path.
# The /VitexSoftware/MultiFlexi/1.0.0 segment is required by the server's
# routing, it is not optional SwaggerHub boilerplate - omitting it will
# make every API call 404/405.
MULTIFLEXI_HOST=https://your-multiflexi-instance.example.com/api/VitexSoftware/MultiFlexi/1.0.0

# Optional: Authentication credentials
MULTIFLEXI_USERNAME=your-username
MULTIFLEXI_PASSWORD=your-password

# Optional: SSL verification (default: true)
MULTIFLEXI_VERIFY_SSL=true

# Optional: Request timeout in seconds (default: 30)
MULTIFLEXI_TIMEOUT=30

# Optional: Maximum number of retries (default: 3)
MULTIFLEXI_MAX_RETRIES=3

# Optional: Enable debug logging (default: false)
MULTIFLEXI_DEBUG=false

# Optional: Read-only mode (default: true). When true, all mutating tools
# (create/update/set/delete/assign/unassign) are rejected before any API
# call is made. Set to false to allow writes.
MULTIFLEXI_READONLY=true
